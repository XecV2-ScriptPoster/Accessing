		<Item class="Script" referent="RBX9694F94C543C413D8C1B1552CBF4183B">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

-- Helper function to configure a character's unique collision group
local function setupCharacterCollisions(character)
	if not character or character:GetAttribute("NoCollideSetup") then return end
	character:SetAttribute("NoCollideSetup", true)

	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then return end

	local groupName = "CharGroup_" .. string.sub(tostring(character), 1, 10) .. "_" .. HttpService:GenerateGUID(false)

	local success, err = pcall(function()
		PhysicsService:RegisterCollisionGroup(groupName)
		PhysicsService:CollisionGroupSetCollidable(groupName, groupName, false)
	end)

	if not success then
		warn("Failed to create collision group: " .. tostring(err))
		return
	end

	local function assignPart(part)
		if part:IsA("BasePart") then
			part.CollisionGroup = groupName
		end
	end

	for _, descendant in ipairs(character:GetDescendants()) do
		assignPart(descendant)
	end

	local descendantConnection = character.DescendantAdded:Connect(assignPart)

	character.Destroying:Connect(function()
		descendantConnection:Disconnect()
		pcall(function()
			PhysicsService:UnregisterCollisionGroup(groupName)
		end)
	end)
end

-- 1. TRACK EXISTING AND NEW PLAYERS
local function trackPlayer(player)
	if player.Character then
		task.spawn(setupCharacterCollisions, player.Character)
	end
	player.CharacterAdded:Connect(setupCharacterCollisions)
end

Players.PlayerAdded:Connect(trackPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	trackPlayer(player)
end

-- 2. TRACK NPCs
local function onWorkspaceChild(child)
	if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
		task.wait() -- FIXED: Replaced invalid task.skip() with task.wait()
		if not Players:GetPlayerFromCharacter(child) then
			setupCharacterCollisions(child)
		end
	end
end

workspace.ChildAdded:Connect(onWorkspaceChild)

for _, child in ipairs(workspace:GetChildren()) do
	task.spawn(onWorkspaceChild, child)
end
]]></ProtectedString>
