		<Item class="Script" referent="RBX1CF9CDA216DD42FB8DD1A6C5B3ED8D35">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- Poll for the RemoteEvent to avoid WaitForChild's "Infinite yield possible" warning
local remoteEvent
while not remoteEvent do
	remoteEvent = ReplicatedStorage:FindFirstChild("CustomControlEvent")
	if not remoteEvent then task.wait(0.5) end
end
remoteEvent:SetAttribute("SConnected", true)

remoteEvent.OnServerEvent:Connect(function(firingPlayer, actionType, actionParam)
	local char = firingPlayer.Character
	if not char then return end

	local balls = char:FindFirstChild("Balls")
	local cu = char:FindFirstChild("cust")
	local w = char:FindFirstChild("wow that was long")
	if not balls or not cu or not w then return end

	local sc = w:FindFirstChildOfClass("SpringConstraint")
	if actionType == "Stiffness" then
		if sc then
			local STIFFNESS_LEVELS = {60, 100, 200, 300, 400, 500}
			local currentIndex = 1
			for i, v in ipairs(STIFFNESS_LEVELS) do
				if sc.Stiffness == v then currentIndex = i break end
			end

			if actionParam == "Lower" then
				currentIndex = math.clamp(currentIndex - 1, 1, #STIFFNESS_LEVELS)
			elseif actionParam == "Higher" then
				currentIndex = math.clamp(currentIndex + 1, 1, #STIFFNESS_LEVELS)
			end
			sc.Stiffness = STIFFNESS_LEVELS[currentIndex]
		end
	elseif actionType == "ToggleParticles" then
		if not cu then return end

		local p2Attachment = cu:FindFirstChild("P2")
		local poAttachment = cu:FindFirstChild("PO")
		if not (p2Attachment and poAttachment) then return end

		local p2Emitter = p2Attachment:FindFirstChildOfClass("ParticleEmitter")
		local poEmitter = poAttachment:FindFirstChildOfClass("ParticleEmitter")
		if not (p2Emitter and poEmitter) then return end

		if not balls then return end

		local newP2State = not p2Emitter.Enabled
		p2Emitter.Enabled = newP2State

		if not balls:GetAttribute("Token") then 
			balls:SetAttribute("Token", 0) 
		end
		local newToken = balls:GetAttribute("Token") + 1
		balls:SetAttribute("Token", newToken)

		if newP2State then
			local currentToken = newToken
			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			raycastParams.FilterDescendantsInstances = {cu, balls} 
			local rayOrigin = cu.Position
			local rayDirection = Vector3.new(0, -50, 0)
			local raycastResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
			local targetFloorCFrame = nil
			if raycastResult then
				targetFloorCFrame = CFrame.new(raycastResult.Position, raycastResult.Position + raycastResult.Normal)
			else
				targetFloorCFrame = cu.CFrame * CFrame.new(0, -3, 0)
			end
			task.delay(0.4, function()
				if balls and balls:GetAttribute("Token") == currentToken then
					if p2Emitter and p2Emitter.Enabled then
						poAttachment.WorldCFrame = targetFloorCFrame
						poEmitter.Enabled = true
					end
				end
			end)
		else
			poEmitter.Enabled = false
		end

	elseif actionType == "TogglePC" then
		local p2Attachment = cu:FindFirstChild("PC")

		if p2Attachment then
			local p2Emitter = p2Attachment:FindFirstChildOfClass("ParticleEmitter")

			if p2Emitter then
				local newP2State = not p2Emitter.Enabled
				p2Emitter.Enabled = newP2State

				if newP2State == true then
					if not balls:GetAttribute("Token") then balls:SetAttribute("Token", 0) end
					local newToken = balls:GetAttribute("Token") + 1
					balls:SetAttribute("Token", newToken)
				end
			end
		end
	elseif actionType == "ToggleVisible" then
		-- Toggle visibility of the Balls part and all its descendants
		if balls then
			local function toggleDescendants(parent)
				for _, child in parent:GetDescendants() do
					if child:IsA("BasePart") then
						child.Transparency = child.Transparency == 0 and 1 or 0
					elseif child:IsA("Decal") or child:IsA("Texture") then
						child.Transparency = child.Transparency == 0 and 1 or 0
					end
				end
			end
			toggleDescendants(balls)
			if cu then toggleDescendants(cu) end
			if w then toggleDescendants(w) end
		end
	end
end)
]]></ProtectedString>
