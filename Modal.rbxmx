		<Item class="LocalScript" referent="RBXE30327CA4CD845E0BD86FF36A6BC97DA">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local customEvent = ReplicatedStorage:WaitForChild("CustomControlEvent", 15)
if not customEvent then return end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	local char = player.Character
	if not char or not char:FindFirstChild("Balls") then return end

	if input.KeyCode == Enum.KeyCode.Q then
		print("Q")
		customEvent:FireServer("Stiffness", "Lower")
	elseif input.KeyCode == Enum.KeyCode.E then
		print("E")
		customEvent:FireServer("Stiffness", "Higher")
	elseif input.KeyCode == Enum.KeyCode.R then
		print("R")
		customEvent:FireServer("ToggleParticles")
	elseif input.KeyCode == Enum.KeyCode.Z then
		print("Z")
		customEvent:FireServer("TogglePC")
	elseif input.KeyCode == Enum.KeyCode.F then
		print("F")
		customEvent:FireServer("ToggleVisible")
	elseif input.KeyCode == Enum.KeyCode.G then
		print("G")
		customEvent:FireServer("ToggleAse")
	elseif input.KeyCode == Enum.KeyCode.X then
		print("X")
		customEvent:FireServer("ToggleP")
	end
end)]]></ProtectedString>
