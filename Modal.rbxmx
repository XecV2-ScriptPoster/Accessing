<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>
	<Item class="ModuleScript" referent="RBX43D1C17EEC524CC0A1DBD86C64C1413A">
		<Properties>
			<Content name="LinkedSource"><null></null></Content>
			<ProtectedString name="Source"><![CDATA[local module = {}
local Players = game:GetService("Players")
local StarterPlayer = game:GetService("StarterPlayer")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

-- 全局發放狀態標記
local allLoopActive = false
local current_colorM = nil
local current_colorS = nil
local current_aseM = nil
local current_aseP = nil
local current_psVisible = nil
local current_is3DP = nil

-- ? Path fix: Modal/Characters/Boi (Yo) + Modal/Characters/FeBoi (YoFe)
local current_variant = "Boi" -- "Boi" | "FeBoi"
local function getBoiFolder()
	return script:WaitForChild("Characters"):WaitForChild("Boi")
end
local function getFeBoiFolder()
	return script:WaitForChild("Characters"):WaitForChild("FeBoi")
end
local function getAssetFolder(variant)
	if variant == "FeBoi" then return getFeBoiFolder() end
	return getBoiFolder()
end
local function ensureClientInput(player)
	local ps = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 5)
	if ps and not ps:FindFirstChild("BallsClientInput") then
		local inputClone = script:WaitForChild("C"):Clone()
		inputClone.Name = "BallsClientInput"
		inputClone.Disabled = false
		inputClone.Parent = ps
	end
end

-- ?? 1. 自動初始化：把 Modal 底下的 RemoteEvent "R" 安全複製到 ReplicatedStorage，方便通訊
local rTemplate = script:WaitForChild("S"):WaitForChild("R")
local remoteEvent = rTemplate:Clone()
remoteEvent.Name = "CustomControlEvent"
remoteEvent.Parent = ReplicatedStorage

-- ??? 1b. 伺服器端事件處理
remoteEvent.OnServerEvent:Connect(function(firingPlayer, actionType, actionParam)
	local char = firingPlayer.Character
	if not char then return end

	local balls = char:FindFirstChild("Balls")
	local cu = char:FindFirstChild("cust")
	local w = char:FindFirstChild("wow that was long")
	if not balls or not cu or not w then return end

	local sc = w:FindFirstChildOfClass("SpringConstraint")
	if actionType == "Stiffness" then
		if sc then
			local STIFFNESS_LEVELS = {40, 60, 100, 200, 300, 400, 500}
			local currentIndex = 1
			for i, v in ipairs(STIFFNESS_LEVELS) do
				if sc.Stiffness == v then currentIndex = i break end
			end

			if actionParam == "Lower" then
				currentIndex = math.clamp(currentIndex - 1, 1, #STIFFNESS_LEVELS)
			elseif actionParam == "Higher" then
				currentIndex = math.clamp(currentIndex + 1, 1, #STIFFNESS_LEVELS)
			end
			sc.Stiffness = STIFFNESS_LEVELS[currentIndex]
		end
	elseif actionType == "ToggleParticles" then
		if not cu then return end

		local p2Attachment = cu:FindFirstChild("P2")
		if not p2Attachment then return end

		local p2Emitter = p2Attachment:FindFirstChildOfClass("ParticleEmitter")
		if not p2Emitter then return end

		if not balls then return end

		local newP2State = not p2Emitter.Enabled
		p2Emitter.Enabled = newP2State

	elseif actionType == "TogglePC" then
		local p2Attachment = cu:FindFirstChild("PC")

		if p2Attachment then
			local p2Emitter = p2Attachment:FindFirstChildOfClass("ParticleEmitter")

			if p2Emitter then
				local newP2State = not p2Emitter.Enabled
				p2Emitter.Enabled = newP2State

				if newP2State == true then
					if not balls:GetAttribute("Token") then balls:SetAttribute("Token", 0) end
					local newToken = balls:GetAttribute("Token") + 1
					balls:SetAttribute("Token", newToken)
				end
			end
		end
	elseif actionType == "ToggleVisible" then
		local hiding = balls.Transparency == 0
		local tip = char:FindFirstChild("Tip")
		balls.Transparency = hiding and 1 or 0
		w.Transparency = hiding and 1 or 0
		if tip then tip.Transparency = hiding and 1 or 0 end
		if hiding then
			for _, emitter in ipairs(cu:GetDescendants()) do
				if emitter:IsA("ParticleEmitter") then
					emitter.Enabled = false
				end
			end
		end
	end
end)

-- ?? 顏色計算（精確大寫匹配）
local function parseRGB(str)
	if type(str) ~= "string" then return nil end
	local r, g, b = string.match(str, "^%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*$")
	if r then
		r, g, b = tonumber(r), tonumber(g), tonumber(b)
		if r and g and b and r <= 255 and g <= 255 and b <= 255 then
			return Color3.fromRGB(r, g, b)
		end
	end
	local hex = string.match(str, "^%s*#?([0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])%s*$")
	if hex then
		local function hx(s) return tonumber(s, 16) end
		return Color3.fromRGB(hx(string.sub(hex, 1, 2)), hx(string.sub(hex, 3, 4)), hx(string.sub(hex, 5, 6)))
	end
	return nil
end

local function computeColors(character, colorM_str, colorS_str)
	local resolvedM = nil
	local resolvedS = nil
	if typeof(colorM_str) == "Color3" then resolvedM = colorM_str end
	if typeof(colorS_str) == "Color3" then resolvedS = colorS_str end
	if colorM_str and colorM_str ~= "Default" and not resolvedM then
		if colorM_str == "Torso" then
			local t = character:FindFirstChild("Torso")
			if t and t:IsA("BasePart") then resolvedM = t.Color end
		elseif colorM_str == "LLeg" then
			local ll = character:FindFirstChild("Left Leg")
			if ll and ll:IsA("BasePart") then resolvedM = ll.Color end
		elseif colorM_str == "RLeg" then
			local rl = character:FindFirstChild("Right Leg")
			if rl and rl:IsA("BasePart") then resolvedM = rl.Color end
		else
			resolvedM = parseRGB(colorM_str)
		end
	end
	if colorS_str and colorS_str ~= "Default" and not resolvedS then
		if colorS_str == "Torso" then
			local t = character:FindFirstChild("Torso")
			if t and t:IsA("BasePart") then resolvedS = t.Color end
		elseif colorS_str == "Dark" then
			if resolvedM then
				local h, s, v = Color3.toHSV(resolvedM)
				resolvedS = Color3.fromHSV(h, s, math.clamp(v * 0.5, 0, 1))
			else
				resolvedS = Color3.fromRGB(40, 40, 40)
			end
		elseif colorS_str == "Bright" then
			if resolvedM then
				local h, s, v = Color3.toHSV(resolvedM)
				resolvedS = Color3.fromHSV(h, math.clamp(s * 0.7, 0, 1), math.clamp(v + (1 - v) * 0.5, 0, 1))
			else
				resolvedS = Color3.fromRGB(230, 230, 230)
			end
		elseif colorS_str == "Pink" then
			resolvedS = Color3.fromRGB(255, 148, 148)
		elseif colorS_str == "Black" then
			resolvedS = Color3.fromRGB(0, 0, 0)
		else
			resolvedS = parseRGB(colorS_str)
		end
	end
	return resolvedM, resolvedS
end

local function computeAseColors(character, colorM_str, colorS_str, aseM_str, aseP_str)
	local baseM, baseS = computeColors(character, colorM_str, colorS_str)
	local aseM = nil
	if typeof(aseM_str) == "Color3" then
		aseM = aseM_str
	elseif aseM_str and aseM_str ~= "Default" then
		local tmpM, _ = computeColors(character, aseM_str, "Default")
		aseM = tmpM
	end
	if aseM == nil then aseM = baseM end

	local aseP = nil
	if typeof(aseP_str) == "Color3" then
		aseP = aseP_str
	elseif aseP_str and aseP_str ~= "Default" then
		local refM = aseM or baseM
		local refMStr
		if refM then
			local r = math.floor(refM.R * 255 + 0.5)
			local g = math.floor(refM.G * 255 + 0.5)
			local b = math.floor(refM.B * 255 + 0.5)
			refMStr = r .. "," .. g .. "," .. b
		else
			refMStr = colorM_str
		end
		local _, tmpS = computeColors(character, refMStr, aseP_str)
		aseP = tmpS
	end
	if aseP == nil then aseP = baseS end
	return aseM, aseP
end

function module.attachAssetsToCharacter(character, folderCharacter, colorM_str, colorS_str, aseM_str, aseP_str, psVisible, is3DP)
	local rootPart = character:WaitForChild("HumanoidRootPart", 5)
	local targetTorso = character:WaitForChild("Torso", 5)
	if not rootPart or not targetTorso then return end
	if rootPart:FindFirstChild("BallsWeld") then return end 

	local tf = folderCharacter:FindFirstChild("Torso") 
	if not tf then return end
	local _wasAnchored = rootPart.Anchored
	rootPart.Anchored = true

	local ckPre = folderCharacter:FindFirstChild("ck")
	local ckTipPre = ckPre and ckPre:FindFirstChild("Tip")
	local ckLongPre = ckPre and ckPre:FindFirstChild("Long")
	local b = folderCharacter:FindFirstChild("Balls") or (ckPre and ckPre:FindFirstChild("Balls"))
	local t = folderCharacter:FindFirstChild("Tip") or (ckTipPre and ckTipPre:FindFirstChild("Tip"))
	local w = folderCharacter:FindFirstChild("wow that was long") or (ckLongPre and ckLongPre:FindFirstChild("wow"))
	local cu = folderCharacter:FindFirstChild("cust") or (ckPre and ckPre:FindFirstChild("cust"))
	local at = tf:FindFirstChild("totw")
	local ckMode = folderCharacter:FindFirstChild("Balls") == nil and ckPre ~= nil
	local loSrc = ckLongPre and ckLongPre:FindFirstChild("Lo")
	local cremSrc = ckTipPre and ckTipPre:FindFirstChild("crem")

	if b and t and w and cu and at then
		local cM, cS = computeColors(character, colorM_str, colorS_str)
		local cAM, cAP = computeAseColors(character, colorM_str, colorS_str, aseM_str, aseP_str)

		local bClone = b:Clone()
		local tClone = t:Clone()
		local wClone = w:Clone()
		local cuClone = cu:Clone()
		local atClone = at:Clone()

		local custWeld = tClone:FindFirstChild("cust")
		if custWeld and custWeld:IsA("Weld") then custWeld.Part0 = tClone; custWeld.Part1 = cuClone end
		local tipWeld = wClone:FindFirstChild("Tip")
		if tipWeld and tipWeld:IsA("Weld") then tipWeld.Part0 = wClone; tipWeld.Part1 = tClone end

		local bsc = wClone:FindFirstChildOfClass("BallSocketConstraint")
		local sc = wClone:FindFirstChildOfClass("SpringConstraint")
		local tobClone = wClone:FindFirstChild("tob")
		local totClone = wClone:FindFirstChild("tot")
		local towClone = bClone:FindFirstChild("tow")

		if bsc and tobClone and towClone then bsc.Attachment0 = tobClone; bsc.Attachment1 = towClone end
		if sc and totClone and atClone then sc.Attachment0 = totClone; sc.Attachment1 = atClone end

		local loClone, cremClone2
		if ckMode then
			local tottbSrc = tf:FindFirstChild("TOTTB")
			if tottbSrc then
				local tottbClone = tottbSrc:Clone()
				tottbClone.Parent = targetTorso
				local ckBSC0 = bClone:FindFirstChildOfClass("BallSocketConstraint")
				local toteee0 = bClone:FindFirstChild("TOTeee")
				if ckBSC0 and toteee0 then ckBSC0.Attachment0 = toteee0; ckBSC0.Attachment1 = tottbClone end
			end
			if loSrc and loSrc:IsA("BasePart") then
				loClone = loSrc:Clone()
				if cAM then pcall(function() loClone.Color = cAM end) end
				loClone.CFrame = targetTorso.CFrame
				loClone.Anchored = false
				loClone.CanCollide = false
				loClone.Massless = true
			end
			if cremSrc and cremSrc:IsA("BasePart") then
				cremClone2 = cremSrc:Clone()
				cremClone2.CFrame = targetTorso.CFrame
				cremClone2.Anchored = false
				cremClone2.CanCollide = false
				cremClone2.Massless = true
			end
			for _, wl in ipairs(wClone:GetChildren()) do
				if wl:IsA("Weld") and wl.Name == "Lo" and loClone then wl.Part0 = wClone; wl.Part1 = loClone end
			end
			for _, wl in ipairs(tClone:GetChildren()) do
				if wl:IsA("Weld") and wl.Name == "crem" and cremClone2 then wl.Part0 = tClone; wl.Part1 = cremClone2 end
			end
		end

		if cM then bClone.Color = cM; wClone.Color = cM end
		if cS then tClone.Color = cS end

		local playerSpecificOffset = CFrame.new(0, -1, -0.5)
		local spawnCFrame = rootPart.CFrame * playerSpecificOffset

		-- Move ALL parts to character position & disable physics weight/collision
		local parts = {bClone, tClone, wClone, cuClone}
		for _, part in ipairs(parts) do
			if part:IsA("BasePart") then
				part.CFrame = spawnCFrame
				part.Anchored = false
				part.CanCollide = false
				part.Massless = true
			end
		end

		local we = Instance.new("Weld")
		we.Name = "BallsWeld"
		we.Part0 = rootPart
		we.Part1 = bClone
		we.C0 = playerSpecificOffset
		if sc then sc.Stiffness = 40 end

		bClone.Parent = character
		tClone.Parent = character
		wClone.Parent = character
		cuClone.Parent = character
		if loClone then loClone.Parent = character end
		if cremClone2 then cremClone2.Parent = character end
		atClone.Parent = targetTorso 
		we.Parent = rootPart

		-- Ase/ck full parts (FeBoi only)
		local aseFolder = folderCharacter:FindFirstChild("ase")
		if aseFolder then
			local bslT, bsrT, sclT, scrT
			local _bslt = tf:FindFirstChild("BSLT")
			local _bsrt = tf:FindFirstChild("BSRT")
			local _sclt = tf:FindFirstChild("SCLT")
			local _scrt = tf:FindFirstChild("SCRT")
			if _bslt then bslT = _bslt:Clone(); bslT.Parent = targetTorso end
			if _bsrt then bsrT = _bsrt:Clone(); bsrT.Parent = targetTorso end
			if _sclt then sclT = _sclt:Clone(); sclT.Parent = targetTorso end
			if _scrt then scrT = _scrt:Clone(); scrT.Parent = targetTorso end

			for _, side in ipairs({"RA","LA"}) do
				local sSrc = aseFolder:FindFirstChild(side)
				if sSrc and sSrc:IsA("BasePart") then
					local sClone = sSrc:Clone()
					if cAM then pcall(function() sClone.Color = cAM end) end

					-- Position relative to Torso and disable touch/collision
					sClone.CFrame = targetTorso.CFrame
					sClone.Anchored = false
					sClone.CanCollide = false
					sClone.CanTouch = false
					sClone.CanQuery = false
					sClone.Massless = true

					for _, d in ipairs(sClone:GetDescendants()) do
						if d:IsA("BasePart") then
							d.Anchored = false
							d.CanCollide = false
							d.CanTouch = false
							d.CanQuery = false
							d.Massless = true
						end
					end

					local bsc2 = sClone:FindFirstChildOfClass("BallSocketConstraint")
					local sc2 = sClone:FindFirstChildOfClass("SpringConstraint")
					local hasValidConstraint = false

					if side == "RA" then
						local bsr = sClone:FindFirstChild("BSR")
						local scr = sClone:FindFirstChild("SCR")
						if bsc2 and bsr and bsrT then 
							bsc2.Attachment0 = bsr; bsc2.Attachment1 = bsrT 
							hasValidConstraint = true
						end
						if sc2 and scr and scrT then 
							sc2.Attachment0 = scr; sc2.Attachment1 = scrT 
						end
					else
						local bsl = sClone:FindFirstChild("BSL")
						local scl = sClone:FindFirstChild("SCL")
						if bsc2 and bsl and bslT then 
							bsc2.Attachment0 = bsl; bsc2.Attachment1 = bslT 
							hasValidConstraint = true
						end
						if sc2 and scl and sclT then 
							sc2.Attachment0 = scl; sc2.Attachment1 = sclT 
						end
					end

					-- Fallback Weld: If BallSocketConstraint or attachments are missing, weld directly to Torso so it never falls!
					if not hasValidConstraint then
						local fallbackWeld = Instance.new("WeldConstraint")
						fallbackWeld.Part0 = targetTorso
						fallbackWeld.Part1 = sClone
						fallbackWeld.Parent = sClone
					end

					for _, wl in ipairs(sClone:GetChildren()) do
						if wl:IsA("Weld") and (wl.Name == "RP" or wl.Name == "LP") then
							local inner = sClone:FindFirstChild(wl.Name)
							if inner then wl.Part0 = sClone; wl.Part1 = inner end
						end
					end

					if cAP then
						for _, d in ipairs(sClone:GetDescendants()) do
							if d:IsA("BasePart") and (d.Name == "RP" or d.Name == "LP") then
								pcall(function() d.Color = cAP end)
							end
						end
					end

					local _psOn = psVisible ~= false
					local _is3D = is3DP == true
					local _pantsSA = sClone:FindFirstChild("Pants")
					local _pMesh = sClone:FindFirstChild(side == "RA" and "RP" or "LP")

					if _pantsSA and _pantsSA:IsA("SurfaceAppearance") then
						local playerPants = character:FindFirstChildOfClass("Pants")
						if playerPants and playerPants.PantsTemplate ~= "" then
							pcall(function() _pantsSA.ColorMap = playerPants.PantsTemplate end)
						else
							pcall(function() _pantsSA.ColorMap = "" end)
							local torsoP = character:FindFirstChild("Torso")
							if torsoP and torsoP:IsA("BasePart") then
								pcall(function() _pantsSA.Color = torsoP.Color end)
							end
						end
					end

					if not _psOn then
						if _pantsSA then pcall(function() _pantsSA.Enabled = false end) end
						if _pMesh and _pMesh:IsA("BasePart") then _pMesh.Transparency = 1 end
					elseif _is3D then
						if _pantsSA then pcall(function() _pantsSA.Enabled = false end) end
						if _pMesh and _pMesh:IsA("BasePart") then _pMesh.Transparency = 0 end
					else
						if _pantsSA then pcall(function() _pantsSA.Enabled = true end) end
						if _pMesh and _pMesh:IsA("BasePart") then _pMesh.Transparency = 1 end
					end

					sClone.Parent = character
				end
			end
		end
	end

	task.wait() -- Let physics settle 1 frame before unanchoring
	rootPart.Anchored = _wasAnchored
end

-- 安全啟用 NoCollide 腳本（改用 Clone 避免二次呼叫報錯）
local function enableNoCollide()
	local collision = script:FindFirstChild("NoCollide")
	if collision and not ServerScriptService:FindFirstChild("NoCollide") then
		local colClone = collision:Clone()
		colClone.Disabled = false
		colClone.Parent = ServerScriptService
	end
end
-- ?? 自動背景配送
local function setupPlayerInputTracking(player)
	player.CharacterAdded:Connect(function(character)
		if allLoopActive then
			local _rf = (current_variant == "FeBoi" and script.Characters.FeBoi) or script.Characters.Boi
			module.attachAssetsToCharacter(character, _rf, current_colorM, current_colorS, current_aseM, current_aseP, current_psVisible, current_is3DP)
		end
		task.defer(function()
			if character:FindFirstChild("Balls") then
				ensureClientInput(player)
			end
		end)
	end)
end
Players.PlayerAdded:Connect(setupPlayerInputTracking)
for _, p in ipairs(Players:GetPlayers()) do setupPlayerInputTracking(p) end
-- ?? 外部對接主接口 (Boi)
function module.Yo(plr, targets, colorM, colorS, aseM, aseP)
	local targetStr = tostring(targets)
	local searchStr = string.lower(targetStr)
	local foundPlayers = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(player.Name), searchStr, 1, true) or string.find(string.lower(player.DisplayName), searchStr, 1, true) then
			table.insert(foundPlayers, player)
		end
	end
	if #foundPlayers == 1 then
		local targetPlayer = foundPlayers[1]
		if targetPlayer.Character then
			module.attachAssetsToCharacter(targetPlayer.Character, script.Characters.Boi, colorM, colorS, aseM, aseP)
			ensureClientInput(targetPlayer)
		end
	elseif #foundPlayers > 1 then
		warn("Yo: 找到多個相符的玩家名稱。")
	else
		if targets == "me" then
			if plr and plr.Character then
				module.attachAssetsToCharacter(plr.Character, script.Characters.Boi, colorM, colorS, aseM, aseP)
				ensureClientInput(plr)
			end
		elseif targets == "all" then
			current_colorM = colorM
			current_colorS = colorS
			current_aseM = aseM
			current_aseP = aseP
			current_variant = "Boi"
			allLoopActive = true
			local customStarterChar = script:FindFirstChild("StarterCharacter")
			if customStarterChar and customStarterChar:IsA("Model") then
				local oldStarterChar = StarterPlayer:FindFirstChild("StarterCharacter")
				if oldStarterChar then oldStarterChar:Destroy() end
				local newStarterChar = customStarterChar:Clone()
				newStarterChar.Parent = StarterPlayer
				for _, p in ipairs(Players:GetPlayers()) do p:LoadCharacter() end
			else
				for _, p in ipairs(Players:GetPlayers()) do
					if p.Character then
						module.attachAssetsToCharacter(p.Character, script.Characters.Boi, colorM, colorS, aseM, aseP)
						ensureClientInput(p)
					end
				end
			end
		else
			local workspaceRig = workspace:FindFirstChild(targetStr)
			if workspaceRig and workspaceRig:IsA("Model") and workspaceRig:FindFirstChild("HumanoidRootPart") then
				module.attachAssetsToCharacter(workspaceRig, script.Characters.Boi, colorM, colorS, aseM, aseP)
			else
				warn("Yo: 找不到符合的目標。")
			end
		end
	end
	enableNoCollide()
end
-- ?? YoFe -> FeBoi (FeBoi variant)
function module.YoFe(plr, targets, colorM, colorS, aseM, aseP, psVisible, is3DP)
	local targetStr = tostring(targets)
	local searchStr = string.lower(targetStr)
	local foundPlayers = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if string.find(string.lower(player.Name), searchStr, 1, true) or string.find(string.lower(player.DisplayName), searchStr, 1, true) then
			table.insert(foundPlayers, player)
		end
	end
	if #foundPlayers == 1 then
		local targetPlayer = foundPlayers[1]
		if targetPlayer.Character then
			module.attachAssetsToCharacter(targetPlayer.Character, script.Characters.FeBoi, colorM, colorS, aseM, aseP, psVisible, is3DP)
			ensureClientInput(targetPlayer)
		end
	elseif #foundPlayers > 1 then
		warn("YoFe: 找到多個相符的玩家名稱。")
	else
		if targets == "me" then
			if plr and plr.Character then
				module.attachAssetsToCharacter(plr.Character, script.Characters.FeBoi, colorM, colorS, aseM, aseP, psVisible, is3DP)
				ensureClientInput(plr)
			end
		elseif targets == "all" then
			current_colorM = colorM
			current_colorS = colorS
			current_aseM = aseM
			current_aseP = aseP
			current_psVisible = psVisible
			current_is3DP = is3DP
			current_variant = "FeBoi"
			allLoopActive = true
			local customStarterChar = script:FindFirstChild("StarterCharacter")
			if customStarterChar and customStarterChar:IsA("Model") then
				local oldStarterChar = StarterPlayer:FindFirstChild("StarterCharacter")
				if oldStarterChar then oldStarterChar:Destroy() end
				local newStarterChar = customStarterChar:Clone()
				newStarterChar.Parent = StarterPlayer
				for _, p in ipairs(Players:GetPlayers()) do p:LoadCharacter() end
			else
				for _, p in ipairs(Players:GetPlayers()) do
					if p.Character then
						module.attachAssetsToCharacter(p.Character, script.Characters.FeBoi, colorM, colorS, aseM, aseP, psVisible, is3DP)
						ensureClientInput(p)
					end
				end
			end
		else
			local workspaceRig = workspace:FindFirstChild(targetStr)
			if workspaceRig and workspaceRig:IsA("Model") and workspaceRig:FindFirstChild("HumanoidRootPart") then
				module.attachAssetsToCharacter(workspaceRig, script.Characters.FeBoi, colorM, colorS, aseM, aseP, psVisible, is3DP)
			else
				warn("YoFe: 找不到符合的目標。")
			end
		end
	end
	enableNoCollide()
end
return module]]></ProtectedString>
